NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/xkld
DB_SSL=false
DB_LOGGING=false
DB_RUN_MIGRATIONS=false
MEDIA_STORAGE_DRIVER=local
MEDIA_UPLOAD_DIR=uploads
MEDIA_PUBLIC_BASE_URL=http://localhost:3001/uploads
MEDIA_MAX_FILE_SIZE_BYTES=5242880
MEDIA_MAX_IMAGE_WIDTH=4096
MEDIA_MAX_IMAGE_HEIGHT=4096
MEDIA_MAX_IMAGE_MEGAPIXELS=16
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_MEDIA_PREFIX=media
